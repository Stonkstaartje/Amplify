# Copy to .env and update as needed
PORT=3000
DOMAIN=https://amplify.bvancroonenburg.nl
ALLOWED_ORIGIN=*
DB_HOST=localhost
DB_NAME=ra121790_amplify
DB_USER=ra121790_amplify
DB_PASS=AwTLgn7up2ZPWSGUXtQg
MAX_UPLOAD_MB=100

# Audio Quality Settings
# Quality tier for uploads: 'any' (all), 'high' (MP3 320k+), 'lossless' (FLAC/WAV)
AUDIO_QUALITY_MODE=high

# Minimum audio bitrate (kbps) - warn if lower
MIN_AUDIO_BITRATE_KBPS=160

# Streaming buffer size (KB) - higher = better quality, lower = less memory
STREAM_BUFFER_KB=64

# Browser cache duration (seconds) - 2592000 = 30 days
BROWSER_CACHE_SECONDS=2592000

